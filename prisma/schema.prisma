generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  name         String?
  grade        String?
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  nickname     String?    @unique
  qtGroup      String?
  chatLogs     ChatLog[]
  feedbacks    Feedback[]

  @@index([email])
  @@index([status])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  verified  Boolean  @default(false)

  @@index([email])
  @@index([code])
}

model ChatLog {
  id        String   @id @default(cuid())
  userId    String
  query     String
  response  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  isVisible Boolean  @default(true)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isPinned  Boolean  @default(false)

  @@index([createdAt])
  @@index([category])
  @@index([isPinned])
}

model SchoolMeal {
  id        String   @id @default(cuid())
  date      String
  menu      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dayOfWeek String

  @@index([date])
}

model SchoolCalendar {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  endDate   String
  eventType String
  name      String
  startDate String

  @@index([startDate])
  @@index([eventType])
}

model Timetable {
  id        String   @id @default(cuid())
  grade     String
  dayOfWeek String
  period    String
  time      String
  subject   String
  teacher   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grade])
  @@index([grade, dayOfWeek])
}

model Post {
  id             String     @id @default(cuid())
  title          String
  content        String
  authorId       String
  authorNickname String?
  viewCount      Int        @default(0)
  isDeleted      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  comments       Comment[]
  likes          PostLike[]

  @@index([createdAt])
  @@index([authorId])
}

model Comment {
  id             String    @id @default(cuid())
  content        String
  postId         String
  authorId       String
  authorNickname String?
  parentId       String?
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  parent         Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Restrict)
  replies        Comment[] @relation("CommentToComment")
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([parentId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model ExamSchedule {
  id        String   @id @default(cuid())
  examType  String
  semester  String
  year      Int
  date      String
  dayOfWeek String
  period    Int
  time      String
  subject   String
  grades    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examType, year, semester])
}

model SubjectCredit {
  id         String   @id @default(cuid())
  grade      String
  subject    String
  credits    Int
  semester   String
  year       Int
  isAcademic Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([grade, subject, semester, year])
  @@index([grade, semester, year])
}

model KnowledgeChunk {
  id         String                       @id
  sourceType String
  sourceId   String
  chunkIndex Int
  title      String
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, sourceId])
}

model Feedback {
  id        String         @id @default(cuid())
  type      FeedbackType   @default(IDEA)
  content   String
  contact   String?
  status    FeedbackStatus @default(PENDING)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model ChapelSchedule {
  id        String   @id @default(cuid())
  date      String   // "2026-09-02"
  month     Int      // 9
  day       Int      // 2
  dayOfWeek String   // "수"
  speaker   String   // "담당자" or "이은세"
  organizer String   // "필리핀 1팀" or "11학년"
  note      String?  // "선교 예배"
  type      String   // "MISSION", "GRADE", "SPECIAL", "EXAM", "SCHOOL"
  year      Int      @default(2026)
  semester  String   @default("2")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year, semester])
  @@index([type])
}

model MissionTeam {
  id          String              @id @default(cuid())
  name        String              @unique // "글로벌팀", "동아시아팀", "필리핀 1팀", "필리핀 2팀"
  leaderName  String              // "김현민"
  leaderGrade Int                 // 11
  chapelDate  String              // "11월 11일"
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     MissionTeamMember[]
}

model MissionTeamMember {
  id        String      @id @default(cuid())
  teamId    String
  team      MissionTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String      // "황은호"
  grade     Int         // 12
  role      String      @default("팀원") // "팀장", "팀원"
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([teamId])
  @@index([name])
}

model QtGroup {
  id             Int             @id // 1, 2, 3, 4, 5, 6, 7, 8
  name           String          // "1조"
  leaderName     String          // "노하임"
  leaderGrade    Int             // 11
  subLeaderName  String          // "윤다애"
  subLeaderGrade Int             // 12
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        QtGroupMember[]
}

model QtGroupMember {
  id        String   @id @default(cuid())
  groupId   Int
  group     QtGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String   // "윤준서"
  grade     Int      // 12
  role      String   @default("조원") // "조장", "부조장", "조원"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([name])
}

enum FeedbackType {
  IDEA
  BUG
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  SUSPENDED
}
